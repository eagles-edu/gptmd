{
  "name": "gptmd",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "diagrams:build": "node scripts/render-diagrams.mjs",
    "diagrams:check": "node scripts/render-diagrams.mjs --check",
    "api:build": "npm --prefix services/api run build",
    "api:dev": "npm --prefix services/api run dev",
    "api:start": "npm --prefix services/api run start",
    "db:up": "docker compose --env-file .env -f ops/postgres.compose.yml up -d",
    "db:down": "docker compose --env-file .env -f ops/postgres.compose.yml down",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "git:update": "node scripts/git-update.js",
    "lint": "eslint .",
    "lint:styles": "stylelint \"**/*.{css,scss,vue}\"",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && npm run test:e2e:run",
    "test:e2e:run": "env -u NO_COLOR playwright test && env -u NO_COLOR playwright test --config=playwright.preflight.config.ts tests/e2e/encounter-preflight.spec.ts",
    "typecheck:font-assets": "tsc -p tsconfig.font-assets-test.json",
    "typecheck:nuxt-config": "tsc -p tsconfig.nuxt-config-test.json",
    "typecheck": "nuxt typecheck",
    "schemas:build": "node scripts/generate-schemas.mjs",
    "schemas:check": "node scripts/generate-schemas.mjs --check",
    "check": "npm run lint && npm run lint:styles && npm run validate:html && npm run typecheck && npm run typecheck:font-assets && npm run typecheck:nuxt-config && npm run test && npm run api:build && npm run schemas:check && npm run diagrams:check && npm run build && npm run test:e2e:run",
    "validate:html": "html-validate \"app/**/*.vue\""
  },
  "dependencies": {
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-bubble-menu": "^3.31.3",
    "@tiptap/extension-code": "^3.31.3",
    "@tiptap/extension-collaboration": "^3.31.3",
    "@tiptap/extension-drag-handle": "^3.31.3",
    "@tiptap/extension-drag-handle-vue-3": "^3.31.3",
    "@tiptap/extension-floating-menu": "^3.31.3",
    "@tiptap/extension-horizontal-rule": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-mention": "^3.31.3",
    "@tiptap/extension-node-range": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/markdown": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@tiptap/suggestion": "^3.31.3",
    "@tiptap/vue-3": "^3.31.3",
    "cookie-es": "^3.1.1",
    "nuxt": "^4.5.2",
    "nuxt-security": "^2.6.0",
    "typescript": "^6.0.3",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@d2lang/d2": "^0.1.34",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.3.2",
    "@nuxtjs/supabase": "^2.0.10",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.11.0",
    "html-validate": "^11.16.1",
    "html-validate-vue": "^9.3.1",
    "jsonc-parser": "^3.3.1",
    "postcss-html": "^2.0.0",
    "sass-embedded": "^1.105.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "vitest": "^5.0.2",
    "vue-tsc": "^3.3.11",
    "vuetify": "^4.2.2",
    "vuetify-nuxt-module": "^1.0.0-rc.6"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "vue-demi@0.14.10": true,
    "esbuild@0.27.2": true,
    "@parcel/watcher": false
  }
}
