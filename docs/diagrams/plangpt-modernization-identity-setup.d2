direction: down
title: GPTpatient modernization · Identity Setup

// Authentication and session creation.
a01: Learner / instructor / customer administrator { shape: person; style.fill: "#E3EAF8"; style.stroke: "#243F70"; style.font-color: "#14243A"; style.font-size: 68; style.stroke-width: 2 }
