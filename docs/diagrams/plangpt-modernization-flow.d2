direction: down

intro: "GPTpatient modernization · PROPOSED TARGET\nCurrent Express API is a health-check scaffold" {
  shape: rectangle
  width: 2480
  height: 400
  style.fill: "#FDEBED"
  style.stroke: "#8A2730"
  style.stroke-width: 12
  style.font-size: 72
  style.bold: true
  style.font-color: "#6E1E27"
}

