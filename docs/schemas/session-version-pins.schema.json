{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SessionVersionPins",
  "type": "object",
  "properties": {
    "promptVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "modelVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "schemaVersion": {
      "type": "number",
      "const": 5
    },
    "policyVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    }
  },
  "required": [
    "promptVersion",
    "modelVersion",
    "schemaVersion",
    "policyVersion"
  ],
  "additionalProperties": false
}
