{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ImmutablePatientScenario",
  "type": "object",
  "properties": {
    "scenarioId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "schemaVersion": {
      "type": "number",
      "const": 7
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "profileDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "profile": {
      "type": "object",
      "properties": {
        "fullName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "dateOfBirth": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        "bodyType": {
          "type": "string",
          "enum": [
            "average",
            "heavy"
          ]
        },
        "reasonForVisit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "diagnosis": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            {
              "type": "null"
            }
          ]
        },
        "painHistoryStatus": {
          "type": "string",
          "enum": [
            "present",
            "absent"
          ]
        },
        "painEpisodes": {
          "maxItems": 2,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "episodeId": {
                "type": "string",
                "enum": [
                  "pain-1",
                  "pain-2"
                ]
              },
              "patientDescription": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "currentStatus": {
                "type": "string",
                "enum": [
                  "current",
                  "intermittent",
                  "past"
                ]
              },
              "details": {
                "minItems": 7,
                "maxItems": 7,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "field": {
                      "type": "string",
                      "enum": [
                        "whatProvokesPalliatesPain",
                        "painQuality",
                        "painLocationRadiationWhere",
                        "painSeverity0-10",
                        "timePainOnset",
                        "constantIntermittentPain",
                        "durationPain"
                      ]
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "known",
                        "negative",
                        "unknown",
                        "not_applicable"
                      ]
                    },
                    "value": {
                      "anyOf": [
                        {
                          "anyOf": [
                            {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 4000
                            },
                            {
                              "type": "number"
                            },
                            {
                              "maxItems": 50,
                              "type": "array",
                              "items": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 500
                              }
                            }
                          ]
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "field",
                    "status",
                    "value"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "episodeId",
              "patientDescription",
              "currentStatus",
              "details"
            ],
            "additionalProperties": false
          }
        },
        "history": {
          "maxItems": 61,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "field": {
                "type": "string",
                "enum": [
                  "lastMenstrualPeriod",
                  "typicalMenstrualPeriodDescription",
                  "dysmenorrheaHistory",
                  "patientConcern",
                  "medicalHistory",
                  "lastPelvicExam",
                  "lastPapSmear",
                  "lastBreastExam",
                  "lastMammogram",
                  "comorbidity",
                  "currentMedications",
                  "allergies",
                  "pastMedications",
                  "nutraceuticalUse",
                  "cannabisUse",
                  "supplementVitaminUse",
                  "tradChineseMedicine",
                  "homeopathicTreatmentsMeds",
                  "acupunctureHistory",
                  "surgicalHistory",
                  "obstetricalHistory",
                  "numberPregnancies",
                  "numberPriorPregnanciesReaching20Weeks",
                  "numberMiscarriage",
                  "numberStillbirths",
                  "numberAbortions",
                  "numberEctopicPregnancies",
                  "numberPregnanciesWithLiveBirth",
                  "numberLiveBirths",
                  "numberChildren",
                  "tubalLigation",
                  "hysterectomyHistory",
                  "perimenopauseStatus",
                  "perimenopauseSymptoms",
                  "menopauseStatus",
                  "menopauseSymptoms",
                  "postmenopauseStatus",
                  "postmenopauseSymptoms",
                  "hormoneReplacementTherapy",
                  "sexualActivityCurrent",
                  "contraceptionMethods",
                  "stdHistory",
                  "familyMedicalHistory",
                  "illicitDrugUse",
                  "methadoneTreatment",
                  "alcoholUse",
                  "nutritionHabits",
                  "sleepQualityQuantity",
                  "mentalHealthCurrent",
                  "mentalHealthPast",
                  "relationshipStatus",
                  "homeEnvironment",
                  "mentalAbuseHistory",
                  "physicalAbuseHistory",
                  "sexualAbuseHistory",
                  "lifeStyle",
                  "employmentHistory",
                  "educationalHistory",
                  "exerciseCurrent",
                  "dnaStudies",
                  "miscellaneousDetailsNos"
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "known",
                  "negative",
                  "unknown",
                  "not_applicable"
                ]
              },
              "value": {
                "anyOf": [
                  {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4000
                      },
                      {
                        "type": "number"
                      },
                      {
                        "maxItems": 50,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 500
                        }
                      }
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "field",
              "status",
              "value"
            ],
            "additionalProperties": false
          }
        },
        "vitalSigns": {
          "type": "object",
          "properties": {
            "currentPulse": {
              "type": "integer",
              "minimum": 1,
              "maximum": 300
            },
            "pulseIrregular": {
              "type": "boolean"
            },
            "pulseQuality": {
              "type": "string",
              "enum": [
                "normal",
                "thready",
                "pounding",
                "weak",
                "absent_radial",
                "absent_carotid",
                "absent_radial_and_carotid"
              ]
            },
            "bpSitting": {
              "type": "object",
              "properties": {
                "systolic": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 300
                },
                "diastolic": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 200
                }
              },
              "required": [
                "systolic",
                "diastolic"
              ],
              "additionalProperties": false
            },
            "bpOrthostaticSupine": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "systolic": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 300
                    },
                    "diastolic": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 200
                    }
                  },
                  "required": [
                    "systolic",
                    "diastolic"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "respiratoryRate": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "axillaryTemp": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 25,
                  "maximum": 45
                },
                {
                  "type": "null"
                }
              ]
            },
            "oralTemp": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 25,
                  "maximum": 45
                },
                {
                  "type": "null"
                }
              ]
            },
            "analTemp": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 25,
                  "maximum": 45
                },
                {
                  "type": "null"
                }
              ]
            },
            "dermalTemp": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 25,
                  "maximum": 45
                },
                {
                  "type": "null"
                }
              ]
            },
            "auralTemp": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 25,
                  "maximum": 45
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "currentPulse",
            "pulseIrregular",
            "pulseQuality",
            "bpSitting",
            "bpOrthostaticSupine",
            "respiratoryRate",
            "axillaryTemp",
            "oralTemp",
            "analTemp",
            "dermalTemp",
            "auralTemp"
          ],
          "additionalProperties": false
        },
        "physicalExamFindings": {
          "type": "object",
          "properties": {
            "lungAuscultation": {
              "type": "object",
              "properties": {
                "breathSounds": {
                  "minItems": 1,
                  "maxItems": 5,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "normal",
                      "wheeze",
                      "fine_rales",
                      "coarse_rales",
                      "rhonchi"
                    ]
                  }
                },
                "ralesDistribution": {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": [
                        "basilar",
                        "diffuse"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "rhonchiSeverity": {
                  "type": "string",
                  "enum": [
                    "none",
                    "mild",
                    "moderate",
                    "marked",
                    "critical"
                  ]
                },
                "effectOfCoughing": {
                  "type": "string",
                  "enum": [
                    "clears",
                    "partially_clears",
                    "unchanged",
                    "worsens",
                    "not_assessed"
                  ]
                },
                "accessoryMuscleUse": {
                  "type": "boolean"
                },
                "postureTolerance": {
                  "type": "string",
                  "enum": [
                    "tolerates_supine",
                    "prefers_upright",
                    "unable_to_tolerate_supine",
                    "not_assessed"
                  ]
                }
              },
              "required": [
                "breathSounds",
                "ralesDistribution",
                "rhonchiSeverity",
                "effectOfCoughing",
                "accessoryMuscleUse",
                "postureTolerance"
              ],
              "additionalProperties": false
            },
            "skinLipsSclera": {
              "type": "object",
              "properties": {
                "skin": {
                  "type": "string",
                  "enum": [
                    "normal",
                    "pale",
                    "cyanotic",
                    "pink",
                    "red",
                    "yellow"
                  ]
                },
                "lips": {
                  "type": "string",
                  "enum": [
                    "normal",
                    "pale",
                    "cyanotic",
                    "pink",
                    "red"
                  ]
                },
                "sclera": {
                  "type": "string",
                  "enum": [
                    "normal",
                    "white",
                    "red",
                    "yellow"
                  ]
                }
              },
              "required": [
                "skin",
                "lips",
                "sclera"
              ],
              "additionalProperties": false
            },
            "skinBlanche": {
              "type": "number",
              "minimum": 0,
              "maximum": 3
            }
          },
          "required": [
            "lungAuscultation",
            "skinLipsSclera",
            "skinBlanche"
          ],
          "additionalProperties": false
        },
        "currentPregnancyStatus": {
          "type": "string",
          "enum": [
            "pregnant",
            "not_pregnant",
            "unknown"
          ]
        },
        "currentMenopausalStatus": {
          "type": "string",
          "enum": [
            "menopausal",
            "not_menopausal",
            "unknown"
          ]
        },
        "patientBeliefs": {
          "maxItems": 30,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "supportedExamFindings": {
          "maxItems": 30,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "supportedTestResults": {
          "maxItems": 30,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "testName": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "result": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            },
            "required": [
              "testName",
              "result"
            ],
            "additionalProperties": false
          }
        },
        "persona": {
          "type": "object",
          "properties": {
            "mood": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "maturity": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "verbosity": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "educationLevel": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "willingnessToDisclose": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          },
          "required": [
            "mood",
            "maturity",
            "verbosity",
            "educationLevel",
            "willingnessToDisclose"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "fullName",
        "dateOfBirth",
        "bodyType",
        "reasonForVisit",
        "diagnosis",
        "painHistoryStatus",
        "painEpisodes",
        "history",
        "vitalSigns",
        "physicalExamFindings",
        "currentPregnancyStatus",
        "currentMenopausalStatus",
        "patientBeliefs",
        "supportedExamFindings",
        "supportedTestResults",
        "persona"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "scenarioId",
    "schemaVersion",
    "createdAt",
    "profileDigest",
    "profile"
  ],
  "additionalProperties": false
}
