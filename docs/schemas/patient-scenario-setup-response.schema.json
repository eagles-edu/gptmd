{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PatientScenarioSetupResponse",
  "type": "object",
  "properties": {
    "sessionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "status": {
      "type": "string",
      "const": "ready"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "patient": {
      "type": "object",
      "properties": {
        "fullName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "dateOfBirth": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        "bodyType": {
          "type": "string",
          "enum": [
            "average",
            "heavy"
          ]
        },
        "reasonForVisit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "required": [
        "fullName",
        "dateOfBirth",
        "bodyType",
        "reasonForVisit"
      ],
      "additionalProperties": false
    },
    "versions": {
      "type": "object",
      "properties": {
        "promptVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "modelVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "schemaVersion": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "policyVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "required": [
        "promptVersion",
        "modelVersion",
        "schemaVersion",
        "policyVersion"
      ],
      "additionalProperties": false
    },
    "readiness": {
      "type": "object",
      "properties": {
        "profile": {
          "type": "boolean",
          "const": true
        },
        "redis": {
          "type": "boolean",
          "const": true
        },
        "conversation": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "profile",
        "redis",
        "conversation"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "sessionId",
    "status",
    "createdAt",
    "patient",
    "versions",
    "readiness"
  ],
  "additionalProperties": false
}
