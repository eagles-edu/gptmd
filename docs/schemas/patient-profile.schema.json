{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PatientProfile",
  "type": "object",
  "properties": {
    "fullName": {
      "type": "string",
      "minLength": 1
    },
    "dateOfBirth": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "bodyType": {
      "type": "string",
      "enum": [
        "average",
        "heavy"
      ]
    },
    "reasonForVisit": {
      "type": "string",
      "minLength": 1
    },
    "vitalSigns": {
      "type": "object",
      "properties": {
        "currentPulse": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "bpSitting": {
          "type": "object",
          "properties": {
            "systolic": {
              "type": "integer",
              "minimum": 1,
              "maximum": 300
            },
            "diastolic": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          },
          "required": [
            "systolic",
            "diastolic"
          ],
          "additionalProperties": false
        },
        "respiratoryRate": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "axillaryTemp": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 25,
              "maximum": 45
            },
            {
              "type": "null"
            }
          ]
        },
        "oralTemp": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 25,
              "maximum": 45
            },
            {
              "type": "null"
            }
          ]
        },
        "analTemp": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 25,
              "maximum": 45
            },
            {
              "type": "null"
            }
          ]
        },
        "dermalTemp": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 25,
              "maximum": 45
            },
            {
              "type": "null"
            }
          ]
        },
        "auralTemp": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 25,
              "maximum": 45
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "currentPulse",
        "bpSitting",
        "respiratoryRate",
        "axillaryTemp",
        "oralTemp",
        "analTemp",
        "dermalTemp",
        "auralTemp"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "fullName",
    "dateOfBirth",
    "bodyType",
    "reasonForVisit",
    "vitalSigns"
  ],
  "additionalProperties": false
}
