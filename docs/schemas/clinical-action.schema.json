{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClinicalAction",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "actionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "sessionId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "turnId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "kind": {
          "type": "string",
          "const": "order"
        },
        "status": {
          "type": "string",
          "enum": [
            "requested",
            "completed",
            "cancelled"
          ]
        },
        "testName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "result": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "actionId",
        "sessionId",
        "turnId",
        "occurredAt",
        "kind",
        "status",
        "testName",
        "result"
      ],
      "additionalProperties": false
    },
