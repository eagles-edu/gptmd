{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AssessmentSubmission",
  "type": "object",
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "differential": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "plan": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "assessmentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "sessionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "turnSequence": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "submittedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "summary",
    "differential",
    "rationale",
    "plan",
    "assessmentId",
    "sessionId",
    "turnSequence",
    "submittedAt"
  ],
  "additionalProperties": false
}
