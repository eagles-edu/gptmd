[Unit]
Description=gptmd Express API
After=network.target

[Service]
Type=simple
User=eaglesvn
Group=eaglesvn
WorkingDirectory=/home/eaglesvn/dockerz/gptmd/services/api
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=4000
ExecStart=/usr/bin/node /home/eaglesvn/dockerz/gptmd/services/api/dist/server.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
