# Review DNS, ACME certificate paths, and the active Nginx layout before installing.
# This template keeps Express private on 127.0.0.1:4000.

server {
    listen 80;
    listen [::]:80;
    server_name api.eaglesvn.club;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/acme;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name api.eaglesvn.club;

    ssl_certificate /etc/letsencrypt/live/api.eaglesvn.club/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.eaglesvn.club/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
