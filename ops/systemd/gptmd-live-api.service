[Unit]
Description=GPTMD live test Express API
After=network.target docker.service

[Service]
Type=simple
LogNamespace=gptmd-live
User=eaglesvn
Group=eaglesvn
SupplementaryGroups=gptmd-ops
WorkingDirectory=/home/obgyn.eaglesvn.club/gptmd/current/api
EnvironmentFile=/home/eaglesvn/.config/gptmd-live/api.env
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=4100
ExecStart=/usr/bin/node /home/obgyn.eaglesvn.club/gptmd/current/api/dist/server.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=30s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
