# Copy to .env and replace local credentials. Never commit .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
ICEPANEL_API_KEY=your-icepanel-api-key-here
# Redis Stack already running on localhost for this development setup.
REDIS_URL=redis://default:replace-me@127.0.0.1:6379/0

# Local PostgreSQL provisioned by: docker compose --env-file .env -f ops/postgres.compose.yml up -d
POSTGRES_DB=gptmd
POSTGRES_USER=gptmd_owner
POSTGRES_PASSWORD=replace-with-a-long-random-value
DATABASE_URL=postgresql://gptmd_owner:replace-with-a-long-random-value@127.0.0.1:5432/gptmd
# HS256 verification key from the trusted identity issuer; use at least 32 random bytes.
API_AUTH_JWT_SECRET=
API_AUTH_JWT_ISSUER=
API_AUTH_JWT_AUDIENCE=gptmd-api
# Optional GPTpatient account entry point settings (must be public URLs/addresses, never credentials).
NUXT_PUBLIC_PAYMENT_PORTAL_URL=
NUXT_PUBLIC_SUPPORT_EMAIL=
POSTGRES_MCP_USER=gptmd_mcp
POSTGRES_MCP_PASSWORD=replace-with-another-long-random-value
POSTGRES_MCP_CONNECTION_STRING=postgresql://gptmd_mcp:replace-with-another-long-random-value@127.0.0.1:5432/gptmd
